# 缓存与运行时文件
data_cache/
runtime/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 前端
web/node_modules/
web/dist/
web/.vite/
# Vite 每次启动会在配置旁生成带时间戳的临时文件（vite.config.ts.timestamp-*.mjs），
# 属构建副产物，不是源码 —— 否则每次跑一次前端就多一个待提交文件。
web/*.timestamp-*.mjs

# 模型产物
models_registry/
*.pkl
*.joblib
*.parquet

# IDE
.idea/
.vscode/
.DS_Store

# 助手工作区（会话日志等本地状态，不入库）
.workbuddy/

# 凭据（重要！）
.env
*.env
config/live.yaml
